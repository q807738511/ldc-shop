{
    "name": "ldc-shop",
    "main": "worker-entry.mjs",
    "keep_names": true,
    "keep_vars": true,
    "compatibility_date": "2025-11-12",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "ldc-shop"
            "database_id": "1bffbcc4-63d5-4008-8b13-f02f86fafd65"
        }
    ],
    "triggers": {
        "crons": [
            "* * * * *"
        ]
    },
    "observability": {
        "enabled": true
    }
}
